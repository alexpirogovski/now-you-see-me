{
  "manifest_version": 3,
  "name": "ChatGPT Avatar Overlay",
  "version": "0.1.0",
  "description": "Displays a fixed avatar overlay on ChatGPT.",
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*"],
      "matches": ["https://chatgpt.com/*"]
    }
  ]
}
