{
  "manifest_version": 3,
  "name": "ChatGPT Avatar Overlay",
  "version": "1.0.0",
  "description": "Displays a fixed avatar overlay on ChatGPT.",
  "permissions": ["storage"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*"],
      "matches": ["https://chatgpt.com/*"]
    }
  ]
}
